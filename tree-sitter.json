{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lilypond",
      "camelcase": "LilyPond",
      "title": "LilyPond",
      "scope": "source.lilypond",
      "file-types": [
        "ly",
        "ily"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^(lilypond|ly)$",
      "class-name": "TreeSitterLilypond"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "LilyPond grammar for tree-sitter",
    "authors": [
      {
        "name": "Baptiste Darthenay"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter-grammars/tree-sitter-lilypond"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
